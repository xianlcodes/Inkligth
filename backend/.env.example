# ============================================================
# InkLight 环境配置示例
# 复制为 .env 并根据实际环境修改
# ============================================================

# ---------- 数据库 ----------
# 方式一：完整 URL（优先）
DATABASE_URL=postgresql+asyncpg://inklight:inklight@localhost:5432/inklight
# 方式二：分散字段（当 DATABASE_URL 为空时使用）
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=inklight
# POSTGRES_PASSWORD=inklight
# POSTGRES_DB=inklight

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT / 安全 ----------
JWT_SECRET=change-me-to-a-random-secret-string

# ---------- 邮件服务 (Brevo) ----------
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=InkLight 研墨
DEV_MODE=false

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads

# ---------- 平台免费额度（新用户赠送的文献翻译）----------
# ★ 推荐在 管理后台 → 系统配置 中直接管理以下 platform_* 配置（数据库优先、立即生效，无需重启）；
#   .env 仅作为后台未配置时的兜底。二选一即可，都配置时后台值优先生效。
# 平台兜底 Key：务必使用免费档模型（如智谱 glm-4.7-flash），调用不产生费用。
# 该 Key 只在服务端使用，绝不下发前端、绝不写日志（后台中仅显示掩码，数据库中加密存储）。
DEFAULT_AI_KEY=
DEFAULT_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 平台额度路径锁定的模型（免费档，勿填付费模型以免消耗余额）
PLATFORM_FALLBACK_MODEL=glm-4.7-flash
# 每个新用户赠送的 PDF 文献翻译次数（篇）；设为 0 停止向新用户赠送
PLATFORM_FREE_TRANSLATIONS=1

# ---------- 日志 ----------
# 应用日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（生产建议挂载卷持久化，如 -v /www/wwwroot/inklight/backend/logs:/app/logs）
LOG_DIR=logs
# 日志文件保留天数
LOG_RETENTION_DAYS=14
# 日志时间戳时区偏移（默认北京时间 UTC+8）
LOG_UTC_OFFSET_HOURS=8.0

# ---------- 嵌入模型 ----------
# 本地路径或 HF 镜像地址（首次运行会自动下载）
EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2
HF_ENDPOINT=https://hf-mirror.com

# ---------- 布局分析模型 (DocLayout-YOLO) ----------
# 首次翻译时会自动从 HuggingFace 下载，可配置镜像
LAYOUT_MODEL_BACKEND=cpu
# LAYOUT_MODEL_BACKEND=cuda  # 如有 GPU 可启用
