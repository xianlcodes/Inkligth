# ============================================================
# InkLight 环境配置示例
# 复制为 .env 并根据实际环境修改
# ============================================================

# ---------- 数据库 ----------
# 方式一：完整 URL（优先）
DATABASE_URL=postgresql+asyncpg://inklight:inklight@localhost:5432/inklight
# 方式二：分散字段（当 DATABASE_URL 为空时使用）
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=inklight
# POSTGRES_PASSWORD=inklight
# POSTGRES_DB=inklight

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT / 安全 ----------
JWT_SECRET=change-me-to-a-random-secret-string

# ---------- 邮件服务 (Brevo) ----------
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=InkLight 研墨
DEV_MODE=false

# ---------- 文件存储 ----------
UPLOAD_DIR=uploads

# ---------- 嵌入模型 ----------
# 本地路径或 HF 镜像地址（首次运行会自动下载）
EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2
HF_ENDPOINT=https://hf-mirror.com

# ---------- 布局分析模型 (DocLayout-YOLO) ----------
# 首次翻译时会自动从 HuggingFace 下载，可配置镜像
LAYOUT_MODEL_BACKEND=cpu
# LAYOUT_MODEL_BACKEND=cuda  # 如有 GPU 可启用
